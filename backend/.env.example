# backend/.env.example
# Copy this file to .env before starting the server:
# cp .env.example .env

# Server URL
VITE_API_URL=http://127.0.0.1:5000

# Google Gemini API Key for AI Assistant (Free tier key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key (optional)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database Configuration (Leave empty to use built-in SQLite automatically)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/agrivision
